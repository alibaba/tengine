ngx_feature="ngx_http_upstream_check_module"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs=
ngx_feature_libs=
ngx_feature_path="$ngx_addon_dir"
ngx_feature_deps="$ngx_addon_dir/ngx_upstream_check_module.h $ngx_addon_dir/ngx_http_upstream_check_module.h $ngx_addon_dir/ngx_http_upstream_check_http_parse.h $ngx_addon_dir/ngx_upstream_check_send_parse.h"
ngx_check_src="$ngx_addon_dir/ngx_http_upstream_check_module.c"
ngx_feature_test="int a;"
. auto/feature

if [ $ngx_found = yes ]; then
    have=NGX_HTTP_UPSTREAM_CHECK . auto/have
    CORE_INCS="$CORE_INCS $ngx_feature_path"
    ngx_addon_name=ngx_http_upstream_check_module
    HTTP_MODULES="$HTTP_MODULES ngx_http_upstream_check_module"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $ngx_feature_deps"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_check_src"
else
    cat << END
    $0: error: the ngx_http_upstream_check_module addon error.
END
    exit 1
fi

#
# Active health checks for stream upstreams. Only a configuration shell: the
# probe machinery lives in the HTTP-side source above and is shared, so the
# stream module cannot be built without it.
#
if [ $STREAM != NO ]; then

    if [ $STREAM = DYNAMIC ]; then
        cat << END
    $0: error: ngx_stream_upstream_check_module does not support building the
    stream module dynamically, because it shares the health-check core with
    ngx_http_upstream_check_module, which is linked statically.
END
        exit 1
    fi

    have=NGX_STREAM_UPSTREAM_CHECK . auto/have

    ngx_module_name=ngx_stream_upstream_check_module
    ngx_module_type=STREAM
    ngx_module_link=ADDON
    ngx_module_incs=$ngx_addon_dir
    ngx_module_deps="$ngx_feature_deps"
    ngx_module_srcs="$ngx_addon_dir/ngx_stream_upstream_check_module.c"

    . auto/module
fi

ngx_feature="compiler structure-packing pragma"
ngx_feature_name="NGX_HAVE_PACK_PRAGMA"
ngx_feature_run=yes
ngx_feature_incs=
ngx_feature_path=
ngx_feature_libs=
ngx_feature_test="#pragma pack(push, 1)
                  struct test_s {
                      char foo;
                      int  bar;
                  };
                  #pragma pack(pop)

                  if (sizeof(struct test_s) != (sizeof(char) + sizeof(int)))
                      return 1;"
. auto/feature

