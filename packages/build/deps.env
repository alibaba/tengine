#
# Pinned third-party sources for the "full feature set" Tengine build:
# Tongsuo (NTLS / Chinese cryptography), xquic (QUIC + HTTP/3) and the Lua
# stack (LuaJIT plus the resty runtime libraries).  None of these ship in any
# distro repository, so every package and every container image builds them
# from source -- which means the versions have to live in exactly one place.
#
# This file is plain POSIX sh and is sourced by fetch-deps.sh, build-deps.sh
# and the packaging recipes.  Each dependency is one variable holding four
# whitespace-separated fields:
#
#     dep_<id>="<github repo> <tag> <tarball top level dir> <sha256>"
#
# The top level directory is spelled out instead of derived: GitHub strips a
# leading "v" from the tag but keeps everything else, which is too subtle to
# recompute correctly for tags like "v2.1-20260724".
#
# To bump a version: change the tag (and directory), then run
#
#     packages/build/fetch-deps.sh --print-checksums
#
# and paste the printed sha256 values back in here.
#

# Order matters: Tongsuo must be built before xquic (it is xquic's SSL
# backend) and LuaJIT before Tengine itself.
TENGINE_DEP_IDS="tongsuo xquic luajit2 resty_core resty_lrucache cjson resty_string resty_lock resty_dns resty_http"

# NTLS. 8.4.0 is the tagged release of the 8.4-stable series that
# .github/workflows/test-ntls.yml exercises.
dep_tongsuo="Tongsuo-Project/Tongsuo 8.4.0 Tongsuo-8.4.0 57c2741750a699bfbdaa1bbe44a5733e9c8fc65d086c210151cfbc2bbd6fc975"

# QUIC/HTTP-3 transport. Built with -DSSL_TYPE=babassl against Tongsuo.
dep_xquic="alibaba/xquic v1.9.4 xquic-1.9.4 088c8970ef4a9e882cf8f1b1de0bfa4165530e4fb6bb9a955467856027c909fd"

# OpenResty's LuaJIT fork -- the only one ngx_http_lua_module supports.
dep_luajit2="openresty/luajit2 v2.1-20260724 luajit2-2.1-20260724 f5b09359b2939ccc769949acf42e0ad2721fa9bb7678c34789059cb44977fc8a"

# Mandatory, not optional: lua_load_resty_core defaults to on, so a Tengine
# built with ngx_http_lua_module refuses to start when resty.core is missing.
dep_resty_core="openresty/lua-resty-core v0.1.32 lua-resty-core-0.1.32 da0d3f052ac2d0d181cd560e5bbf04a571636be41882a84af9e557cbe88a5104"
dep_resty_lrucache="openresty/lua-resty-lrucache v0.15 lua-resty-lrucache-0.15 8cf1a22e0d5b8f35cb0b2e14c58fcb3aa505a8fb6e956817f0cdb1f06593f072"

# Commonly required by user Lua code. cjson is the only C module here.
dep_cjson="openresty/lua-cjson 2.1.0.19 lua-cjson-2.1.0.19 d1aded44b4cfe5ec6b395e178902aba3eed1dbe7999a753c0662222de2890ec0"
dep_resty_string="openresty/lua-resty-string v0.19 lua-resty-string-0.19 8b3e17e8796f083228b89ddd013bcc688c7d15afcc721c70059fd4a8bf2355dc"
dep_resty_lock="openresty/lua-resty-lock v0.09 lua-resty-lock-0.09 b4ddcd47db347e9adf5c1e1491a6279a6ae2a3aff3155ef77ea0a65c998a69c1"
dep_resty_dns="openresty/lua-resty-dns v0.23 lua-resty-dns-0.23 ecc80b91bfb4f795b8a80acfa69e1778288ef60649ddd87f30a9c4a57ac5da79"
dep_resty_http="ledgetech/lua-resty-http v0.18.0 lua-resty-http-0.18.0 d84e87bfea7bc1b91c52a27c9464d1412823ce748fd13d3885308f21166f946b"
