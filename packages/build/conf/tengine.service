[Unit]
Description=Tengine HTTP and reverse proxy server
Documentation=https://tengine.taobao.org/
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/tengine.pid
ExecStartPre=/usr/sbin/tengine -t
ExecStart=/usr/sbin/tengine
ExecReload=/usr/sbin/tengine -t
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

# Every connection costs at least one descriptor, upstreams and log files more,
# so the inherited 1024 is reached long before worker_connections is. el7-era
# systems are where this bites: the default there really is 1024, which the
# stock worker_connections exactly exhausts.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
