/Makefile
/objs*/
/tmp/
/tags

# Package build artifacts (packages/build/build.sh)
/dist/

# debhelper build artifacts - regenerated on every build, must not be committed
packages/debian/files
packages/debian/*.substvars
packages/debian/*.debhelper
packages/debian/*.debhelper.log

# Build artifacts generated by module config scripts
modules/ngx_http_lua_module/src/ngx_http_lua_autoconf.h

# macOS metadata files
.DS_Store

# Editor / IDE files
.vscode/

# Local working notes: analysis reports, migration plans, scratch drafts.
# Keep these out of the tree entirely - this repository is a public fork, and
# a note pushed by mistake stays reachable by SHA even after a force-push.
# Patterns are case-sensitive, so lowercase files such as
# .github/ISSUE_TEMPLATE/bug_report.md are unaffected.
*_ANALYSIS.md
*_PLAN.md
*_NOTES.md
*_REPORT.md
*_REVIEW.md
*_DRAFT.md
*_MEMO.md
*_TODO.md
*.local.md
*.internal.md
*.draft.md
*.wip.md
/NOTES.md
/TODO.md
.notes/
scratch/
drafts/

# Test temporary files
tests/nginx-tests/tengine-tests/ckeys.log
tests/nginx-tests/tengine-tests/clog
tests/nginx-tests/tengine-tests/lib
tests/nginx-tests/tengine-tests/test_session
tests/nginx-tests/tengine-tests/tp_localhost
tests/nginx-tests/tengine-tests/xqc_token
